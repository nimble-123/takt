{
  "sourceLanguage": "en",
  "strings": {
    "%@ is still running. Forgot to stop it?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ läuft noch. Vergessen zu stoppen?"
          }
        }
      }
    },
    "Azure DevOps token expires soon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure-DevOps-Token läuft bald ab"
          }
        }
      }
    },
    "Open Takt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takt öffnen"
          }
        }
      }
    },
    "Quit Takt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takt beenden"
          }
        }
      }
    },
    "Renew the token for %@ and enter it in Takt's settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneuere das Token für %@ und trage es in den Einstellungen von Takt ein."
          }
        }
      }
    },
    "Settings …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen …"
          }
        }
      }
    },
    "Takt": {
      "shouldTranslate": false
    },
    "Takt could not open its database.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takt konnte seine Datenbank nicht öffnen."
          }
        }
      }
    },
    "Timer running for over 10 hours": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer läuft seit über 10 Stunden"
          }
        }
      }
    },
    "Welcome to Takt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Takt"
          }
        }
      }
    }
  },
  "version": "1.0"
}